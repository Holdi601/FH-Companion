{
  "launch": {
    "command": "steam://rungameid/2483190",
    "arguments": [],
    "startup_wait_seconds": 90
  },
  "window": {
    "process_names": [
      "forzahorizon6"
    ],
    "title_regex": "^Forza Horizon 6$",
    "focus_timeout_seconds": 120,
    "refocus_timeout_seconds": 8,
    "ensure_focus_before_actions": true,
    "alt_tab_fallback": true
  },
  "display": {
    "manage": false,
    "mode_before_launch": "Windowed",
    "restore_after": true,
    "backup_root": "data/backups/forza_display"
  },
  "capture": {
    "output_dir": "data/inbox/auto",
    "state_dir": "data/inbox/auto/_state",
    "prefix": "fh6_rivals",
    "clear_output_dir": false,
    "dump_state_ocr": true,
    "ocr_language": "en"
  },
  "steps": [
    {
      "action": "wait_for_text",
      "pattern": "Horizon|Campaign|Cars|Online|Rivals|Press",
      "timeout_seconds": 120,
      "interval_seconds": 2,
      "name": "state_home_{index:000}.png"
    },
    {
      "action": "observe",
      "name": "home_seen_{index:000}.png"
    },
    {
      "action": "click_text",
      "pattern": "Online|Rivals",
      "delay_ms": 1200,
      "name": "click_online_or_rivals_{index:000}.png"
    },
    {
      "action": "key_until_text",
      "key": "DOWN",
      "pattern": "Rivals",
      "max_presses": 8,
      "delay_ms": 500,
      "name": "find_rivals_{index:000}.png"
    },
    {
      "action": "click_text",
      "pattern": "Rivals",
      "delay_ms": 1500,
      "name": "click_rivals_{index:000}.png"
    },
    {
      "action": "observe",
      "name": "route_calibration_{index:000}.png"
    },
    {
      "action": "repeat",
      "count": 20,
      "steps": [
        {
          "action": "screenshot",
          "name": "leaderboard_{index:000}.png"
        },
        {
          "action": "key",
          "key": "PAGEDOWN",
          "delay_ms": 900
        }
      ]
    }
  ],
  "extraction": {
    "enabled": true,
    "track": "REPLACE_WITH_TRACK_NAME",
    "performance_class": "S1",
    "pi_class": "S1",
    "event_type": "Rivals",
    "rivals_mode": "Road Racing",
    "profile": "config/fh6_rivals_1080p.json",
    "output_dir": "data/processed",
    "sqlite_path": "data/processed/leaderboard_entries.sqlite",
    "parquet_path": "data/processed/leaderboard_entries.parquet",
    "dump_ocr": true,
    "keep_crops": false
  }
}
